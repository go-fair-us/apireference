{
    "@context": "https://schema.org",
    "@type": "Dataset",
    "@id": "https://example.org/datasets/vector-006",
    "name": "Aedes Mosquito Surveillance Network - Americas Region 2023",
    "description": "EXAMPLE DATA - NOT REAL. This fictitious dataset contains mosquito trap collection data from a simulated continental surveillance network monitoring Aedes aegypti and Aedes albopictus populations. Includes species counts, geolocation, environmental variables, and pathogen detection results.",
    "identifier": {
        "@type": "PropertyValue",
        "propertyID": "DOI",
        "value": "10.99999/example.vector.006"
    },
    "url": "https://example.org/datasets/vector-006",
    "keywords": ["Aedes aegypti", "Aedes albopictus", "mosquito surveillance", "vector control", "Zika", "dengue", "chikungunya", "entomology"],
    "license": "https://opendatacommons.org/licenses/by/1-0/",
    "creator": {
        "@type": "Organization",
        "name": "Example Vector Surveillance Consortium",
        "url": "https://example.org/consortia/vector-surveillance"
    },
    "contributor": [
        {
            "@type": "Organization",
            "name": "Example Ministry of Health - Brazil"
        },
        {
            "@type": "Organization",
            "name": "Example CDC Vector-Borne Division"
        },
        {
            "@type": "Organization",
            "name": "Example University Entomology Department"
        }
    ],
    "publisher": {
        "@type": "Organization",
        "name": "Example Environmental Health Data Center"
    },
    "datePublished": "2024-02-01",
    "dateModified": "2024-06-15",
    "temporalCoverage": "2023-01-01/2023-12-31",
    "spatialCoverage": {
        "@type": "Place",
        "name": "Americas (North, Central, South America, Caribbean)",
        "geo": {
            "@type": "GeoShape",
            "box": "-55.0 -180.0 72.0 -30.0"
        }
    },
    "distribution": [
        {
            "@type": "DataDownload",
            "encodingFormat": "text/csv",
            "contentUrl": "https://example.org/datasets/vector-006/trap_collections.csv",
            "description": "Weekly trap collection data"
        },
        {
            "@type": "DataDownload",
            "encodingFormat": "application/geo+json",
            "contentUrl": "https://example.org/datasets/vector-006/trap_locations.geojson",
            "description": "Trap site locations"
        },
        {
            "@type": "DataDownload",
            "encodingFormat": "application/x-netcdf",
            "contentUrl": "https://example.org/datasets/vector-006/climate_data.nc",
            "description": "Associated climate variables"
        }
    ],
    "measurementTechnique": ["BG-Sentinel traps", "Gravid traps", "CDC light traps", "RT-PCR for pathogen detection"],
    "variableMeasured": [
        "Species count per trap-night",
        "Female/male ratio",
        "Pathogen infection rate",
        "Temperature",
        "Precipitation",
        "Humidity"
    ],
    "hasPart": [
        {
            "@type": "Dataset",
            "name": "Aedes aegypti subset"
        },
        {
            "@type": "Dataset",
            "name": "Aedes albopictus subset"
        },
        {
            "@type": "Dataset",
            "name": "Pathogen detection results"
        }
    ],
    "isAccessibleForFree": true,
    "conditionsOfAccess": "Open access with attribution required"
}
