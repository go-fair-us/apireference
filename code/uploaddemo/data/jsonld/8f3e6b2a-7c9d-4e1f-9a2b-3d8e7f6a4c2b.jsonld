    },
    {
      "@type": "DefinedTerm",
      "name": "biomass",
      "inDefinedTermSet": "https://www.ebi.ac.uk/ols4/ontologies/ENVO",
      "url": "http://purl.obolibrary.org/obo/ENVO_00002034"
    },
    {
      "@type": "DefinedTerm",
      "name": "Decapoda",
      "inDefinedTermSet": "https://www.ebi.ac.uk/ols4/ontologies/NCBITaxon",
      "url": "http://purl.obolibrary.org/obo/NCBITaxon_6681"
    },
    {
      "@type": "DefinedTerm",
      "name": "geospatial",
      "inDefinedTermSet": "https://www.ebi.ac.uk/ols4/ontologies/OGI",
